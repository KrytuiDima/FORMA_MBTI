{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "forma-mbti-api",
  "main": "./worker.js",
  "compatibility_date": "2026-11-17",
  "workers_dev": true,
  "keep_vars": true,
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "82887547302742909f3d6eb5c18fb830"
    }
  ],
  "vars": {
    "GEMINI_MODEL": "gemini-2.5-flash",
    "SITE_URL": "https://krytuidima.github.io/FORMA_MBTI/",
    "SITE_ORIGIN": "https://krytuidima.github.io"
  }
}
